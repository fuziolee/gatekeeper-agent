# Copy to .env and fill in. The server also reads these from the environment.
# AGENT_GAMES_HMAC_SECRET: the 32-byte secret from the Agent Games dashboard
# (Rotate Secret). REQUIRED before registering the endpoint — without it the
# server runs in dev mode and accepts unsigned requests. After rotating the
# secret, restart the server (scripts/start.sh stop && scripts/start.sh).
AGENT_GAMES_HMAC_SECRET=
# PORT: local port the agent listens on (tunnelled by cloudflared).
PORT=8788
# HOST: bind address (127.0.0.1 — only the local tunnel reaches it).
HOST=127.0.0.1
